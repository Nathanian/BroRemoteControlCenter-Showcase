<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtStatus"
            style="@style/TextAppearance.BroRCC.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected" />

        <TextView
            android:id="@+id/txtTopics"
            style="@style/TextAppearance.BroRCC.LogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Topics:"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Received:"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scrollReceived"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/card_background"
            android:padding="12dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/txtReceived"
                style="@style/TextAppearance.BroRCC.LogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sent:"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scrollPublished"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/card_background"
            android:padding="12dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/txtPublished"
                style="@style/TextAppearance.BroRCC.LogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_exit"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
