<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="deviceinfo.json"/>
        <include domain="file" path="brovnc-key.pem"/>
        <exclude domain="file" path="logs/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="deviceinfo.json"/>
        <include domain="file" path="brovnc-key.pem"/>
        <exclude domain="file" path="logs/"/>
    </device-transfer>
</data-extraction-rules>
